[Icon Theme]
Name=Cachy7
Comment=Windows 7 inspired glossy icons for the Cachy7 OLED theme
Inherits=breeze-dark,breeze,hicolor
Example=folder
DisplayDepth=32
LinkOverlay=link
LockOverlay=lockoverlay
ZipOverlay=zipoverlay
DesktopDefault=48
ToolbarDefault=22
MainToolbarDefault=22
SmallDefault=16
PanelDefault=48
DialogDefault=32
FollowsColorScheme=false

Directories=scalable/places,scalable/devices,scalable/apps,scalable/mimetypes

[scalable/places]
Size=48
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[scalable/devices]
Size=48
MinSize=16
MaxSize=512
Context=Devices
Type=Scalable

[scalable/apps]
Size=48
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[scalable/mimetypes]
Size=48
MinSize=16
MaxSize=512
Context=MimeTypes
Type=Scalable
